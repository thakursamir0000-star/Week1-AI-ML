# Configuration template. Create .env from it only if .env does not exist yet:
#     test -f .env || cp .env.example .env
# .env is listed in .gitignore. Never commit it, and never paste a key into code.
# Each provider uses its own key; set only the ones you use.

# --- Groq (used by: groq-classify) --------------------------------------------
# Create a key at https://console.groq.com/keys (it starts with "gsk_").
GROQ_API_KEY=your-groq-api-key-here

# Optional: Groq model. Default: openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-20b

# --- Anthropic (used by: ping, classify) --------------------------------------
# Create a key in the Anthropic Console (it starts with "sk-ant-").
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Claude model. Default: claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# Optional: server-side refusal fallback (beta). Default: true.
# Set to false if the API answers 400 about the "anthropic-beta" header.
# CLAUDE_USE_FALLBACKS=true
